# ------------------------------------------------------- прод-инстанс (bin/)
# bin\ — рабочий экземпляр: сборка, рабочие конфиги, история, журналы.
# В репозиторий не попадает НИЧЕГО из этого каталога: ни бинарники, ни конфиги.
# Создаётся и обновляется скриптом build.cmd (tools\build-prod.ps1).
bin/

# ---------------------------------------------------------------- build output
obj/
publish/
artifacts/
*.user*.suo
*.userprefs
*.cache
*.pdb
*.nupkg
*.snupkg
*.log.bak

# ---------------------------------------------------------------- runtime data
data/
logs/
cache/
state/
auth/
config/secrets.json
config/settings.json
config/env.json
config/companies/*.json
!config/companies/*.example.json

# ---------------------------------------------------------------- IDE / OS
.vs/
.vscode/
.idea/
*.DotSettings.user
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------- temp
*.tmp
*.temp
*.bak
*.orig
*.rej
~$*

# ---------------------------------------------------------------- передача сессий
# Рабочие заметки для продолжения работы (docs/HANDOFF-*.md и промпт к ним):
# это состояние сессии, а не документация продукта. Файлы остаются на диске.
docs/HANDOFF-*
docs/HANDOFF-PROMPT.txt
