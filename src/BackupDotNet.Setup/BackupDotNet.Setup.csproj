<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BackupDotNet.Setup</AssemblyName>
    <RootNamespace>BackupDotNet.Setup</RootNamespace>
    <ApplicationIcon>..\..\assets\setup-icon.ico</ApplicationIcon>
    <StartupObject>BackupDotNet.Setup.Program</StartupObject>
    <!-- Окно установщика — всегда 64-битное: WebView2Loader берётся x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackupDotNet.Core\BackupDotNet.Core.csproj" />
    <ProjectReference Include="..\BackupDotNet.Deploy\BackupDotNet.Deploy.csproj" />
  </ItemGroup>

  <!--
    Страницы мастера лежат рядом с exe в setup-ui\.
    Копируются как содержимое, а не встраиваются: так их можно править
    без пересборки — полезно, когда установщик уже разошёлся по машинам.
  -->
  <ItemGroup>
    <Content Include="..\..\setup-ui\**\*">
      <Link>setup-ui\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Иконка окна: нужна и как файл, чтобы Form.Icon не зависел от ресурсов exe. -->
  <ItemGroup>
    <Content Include="..\..\assets\setup-icon.ico">
      <Link>setup-ui\setup-icon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\setup-icon.png">
      <Link>setup-ui\setup-icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Font Awesome — тот же, что у веб-интерфейса. Копируется в setup-ui\vendor\fa,
    чтобы мастер выглядел как продукт и при этом был самодостаточным.
  -->
  <ItemGroup>
    <Content Include="..\..\public\vendor\fa\**\*">
      <Link>setup-ui\vendor\fa\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
