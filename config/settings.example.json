{
  "agent": {
    "name": "BackupDotNet",
    "dataDir": "data",
    "publicDir": "public",
    "configDir": "config",
    "httpPort": 8080,
    "bindAddress": "http://+:8080/",
    "timezone": "Europe/Moscow",
    "language": "ru"
  },
  "scheduler": {
    "tickSeconds": 60,
    "jitterSeconds": 120,
    "maxParallelChecks": 4,
    "defaultIntervalMinutes": 60
  },
  "veeam": {
    "requestTimeoutSeconds": 30,
    "ignoreCertErrorsDefault": true,
    "restApiVersion": "1.1-rev1"
  },
  "zip": {
    "tempDir": "",
    "crcReadBufferKb": 256
  },
  "zabbix": {
    "enabled": false,
    "server": "",
    "port": 10051,
    "mode": "sender",
    "timeoutSeconds": 5,
    "batchSize": 500,
    "batchMaxBytes": 65536,
    "api": {
      "enabled": false,
      "url": "",
      "token": "",
      "autoCreateHosts": false,
      "hostGroup": "Backup",
      "templateName": "BackupDotNet"
    }
  },
  "web": {
    "requireAuth": true,
    "sessionTimeoutMinutes": 480
  },
  "logging": {
    "level": "info",
    "maxFileSizeMb": 32,
    "keepDays": 90,
    "publicEnabled": true
  },
  "history": {
    "journalKeepDays": 400,
    "rollupKeepMonths": 60,
    "autoPrune": true
  },
  "backup": {
    "destination": "",
    "retention": {
      "keepCount": 7,
      "keepDays": 14,
      "gfs": { "daily": 7, "weekly": 8, "monthly": 12 },
      "protectLast": true,
      "maxDeletePerRun": 10
    }
  },
  "vm": {
    "protectedPatterns": ["LH_*", "DPT_*"],
    "maxBatchSize": 5,
    "quarantineDays": 7,
    "requireForceForProtected": true
  },
  "storage": {
    "targets": [
      { "path": "\\\\fileserver\\Backups", "label": "основное хранилище" }
    ]
  },
  "updates": {
    "enabled": false,
    "source": "local",
    "path": "\\\\fileserver\\BackupDotNet\\latest",
    "githubRepo": "",
    "githubApiBase": "",
    "githubTokenSecret": "github-token",
    "allowInstall": false,
    "checkOnStart": true
  },
  "notifications": {
    "enabled": false,
    "on": {
      "fail": true,
      "warn": true,
      "recover": true,
      "nodata": false
    },
    "minIntervalMinutes": 30,
    "quietHours": { "from": "", "to": "" },
    "smtp": {
      "enabled": false,
      "host": "",
      "port": 25,
      "useSsl": false,
      "username": "",
      "passwordSecret": "smtp-password",
      "from": "",
      "to": [],
      "timeoutSeconds": 20
    },
    "telegram": {
      "enabled": false,
      "tokenSecret": "telegram-token",
      "chats": []
    }
  }
}
