<Project>

  <!-- ==========================================================================
       BackupDotNet — общие свойства сборки.
       Целевая платформа: .NET Framework 4.8 (никаких сторонних NuGet-пакетов).
       Всё, что используется извне, — только то, что уже есть в Windows:
       System.Management, System.DirectoryServices, Windows PowerShell 5.1.
       ========================================================================== -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Company>BackupDotNet</Company>
    <Product>BackupDotNet</Product>
    <AssemblyTitle>BackupDotNet</AssemblyTitle>
    <Description>Мониторинг бэкапов, доступности и железа</Description>
    <Copyright>BackupDotNet contributors</Copyright>
    <VersionPrefix>1.1.0</VersionPrefix>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS1591;CS0162;CS0219;CS0414;CS0649;SYSLIB0014</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Общие ссылки на сборки .NET Framework: нужны всем проектам. -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Security" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- dynamic (TasksCollector) -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- ==========================================================================
       Windows PowerShell 5.1 (System.Management.Automation) входит в состав ОС.
       Путь фиксированный: сборка версии 3.0.0.0 в GAC_MSIL.
       Никаких NuGet-пакетов — сборка должна собираться офлайн.
       ========================================================================== -->
  <PropertyGroup>
    <PowerShellAssemblyPath>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\System.Management.Automation\v4.0_3.0.0.0__31bf3856ad364e35\System.Management.Automation.dll</PowerShellAssemblyPath>
    <PowerShellAvailable>false</PowerShellAvailable>
    <PowerShellAvailable Condition="Exists('$(PowerShellAssemblyPath)')">true</PowerShellAvailable>
  </PropertyGroup>

  <ItemGroup Condition="'$(PowerShellAvailable)' == 'true'">
    <Reference Include="System.Management.Automation">
      <HintPath>$(PowerShellAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Диагностика: без PowerShell-сборки отключатся WinRM и модуль «Управление». -->
  <Target Name="WarnMissingPowerShell" BeforeTargets="BeforeBuild" Condition="'$(PowerShellAvailable)' != 'true'">
    <Warning Text="System.Management.Automation.dll не найдена: удалённое развёртывание и модуль «Управление» будут недоступны." />
  </Target>

</Project>
